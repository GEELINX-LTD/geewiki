# 依赖
node_modules/

# 构建产物与缓存
dist/
coverage/
.vite/
.cache/
.npm-cache/
.pnpm-store/
.pnpm-cache/
tmp/

# 环境变量（.env.example 除外，可作为模板提交）
.env
.env.*
!.env.example

# 运行时数据（SQLite 数据库 data/geewiki.db、崩溃标记 data/crash.marker 等本机状态）
data/
*.db
*.db-journal
*.db-shm
*.db-wal

# 运行期会话清单（运行时被改写，属本机状态；基础层清单 plugins.base.json 保留入库）
config/plugins.session.json

# 日志
logs/
*.log

# 系统文件
.DS_Store

# 本地沙箱 pnpm/npm 配置（store/cache 置于仓库内，仅本地环境需要）
.npmrc
