data/
*.db
*.db-journal
*.db-shm
*.db-wal

# 日志
logs/
*.log

# 系统文件
.DS_Store

# 本地沙箱 pnpm/npm 配置（store/cache 置于仓库内，仅本地环境需要）
.npmrc
