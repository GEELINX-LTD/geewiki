# 依赖
node_modules/

# 构建产物与缓存
dist/
coverage/
.vite/
.cache/
.npm-cache/
.pnpm-store/
.pnpm-cache/
tmp/

# 插件前端产物（由 `pnpm --filter @geewiki/web build:fixtures` 生成，源码在 packages/web/fixtures/）
packages/web/public/plugins-ui/

# 环境变量（.env.example 除外，可作为模板提交）
.env
.env.*
!.env.example

# 运行时数据（SQLite 数据库 data/geewiki.db、崩溃标记 data/crash.marker 等本机状态）
data/
*.db
*.db-journal
*.db-shm
*.db-wal

# 配置目录：**默认全部忽略**，只放行"随版本发布的默认值"模板 plugins.base.example.json。
#
# 这里装的全部是本机运行期状态，且都会被进程改写：
#   plugins.base.json     基础层清单（保存配置时改写；首次写入时生成）
#   plugins.session.json  会话层清单（启用/停用/持久化时改写）
#   secrets.json          role:'secret' 字段的**值**（模型 API key 等）
#
# 为什么是默认拒绝而不是逐个拉黑：逐个拉黑意味着"下次新增一个本机配置文件时，
# 默认后果是提交进 git"。这条与 .dockerignore 的同名规则必须同时成立——那边漏一个，
# 本机密钥就会被 COPY 进镜像层（见 config/plugins.base.example.json 的文件头注释）。
config/*
!config/plugins.base.example.json

# 日志
logs/
*.log

# 系统文件
.DS_Store

# 本地沙箱 pnpm/npm 配置（store/cache 置于仓库内，仅本地环境需要）
.npmrc
