# 依赖
node_modules/

# 构建产物与缓存
dist/
coverage/
.vite/
.cache/
.npm-cache/
.pnpm-store/
.pnpm-cache/
tmp/

# 插件前端产物（由 `pnpm --filter @geewiki/web build:fixtures` 生成，源码在 packages/web/fixtures/）
packages/web/public/plugins-ui/

# 环境变量（.env.example 除外，可作为模板提交）
.env
.env.*
!.env.example

# 运行时数据（SQLite 数据库 data/geewiki.db、崩溃标记 data/crash.marker 等本机状态）
data/
*.db
*.db-journal
*.db-shm
*.db-wal

# 运行期会话清单（运行时被改写，属本机状态；基础层清单 plugins.base.json 保留入库）
config/plugins.session.json

# 密钥文件（模型 API key 等 role:'secret' 字段的落盘位置：绝不进版本库）
# 注意：plugins.base.json / plugins.session.json 里**只有**"是否已配置"，没有值
config/secrets.json

# 日志
logs/
*.log

# 系统文件
.DS_Store

# 本地沙箱 pnpm/npm 配置（store/cache 置于仓库内，仅本地环境需要）
.npmrc
