{
  "name": "geewiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GeeWiki —— AI-Native 插件化知识库系统（Phase 0 骨架）",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "GEEWIKI_PLUGIN_UI_DIST=packages/web/public tsx packages/server/src/index.ts & SERVER_PID=$!; pnpm --filter @geewiki/web run dev; S=$?; kill $SERVER_PID 2>/dev/null; exit $S",
    "dev:server": "tsx packages/server/src/index.ts",
    "dev:web": "pnpm --filter @geewiki/web run dev",
    "build": "pnpm -r --if-present run build",
    "start": "tsx packages/server/src/index.ts",
    "typecheck": "pnpm -r --no-bail --if-present run typecheck && tsc --noEmit -p tsconfig.scripts.json",
    "test": "pnpm -r --no-bail --if-present run test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "new:plugin": "tsx scripts/create-plugin.ts",
    "clean:tmp": "tsx scripts/clean-tmp.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "install-plugin": "tsx scripts/install-plugin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
