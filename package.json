{
  "name": "geewiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GeeWiki —— AI-Native 插件化知识库系统（Phase 0 骨架）",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "GEEWIKI_PLUGIN_UI_DIST=packages/web/public tsx packages/server/src/index.ts & SERVER_PID=$!; pnpm --filter @geewiki/web run dev; S=$?; kill $SERVER_PID 2>/dev/null; exit $S",
    "dev:server": "tsx packages/server/src/index.ts",
    "dev:web": "pnpm --filter @geewiki/web run dev",
    "build": "pnpm -r --if-present run build",
    "start": "tsx packages/server/src/index.ts",
    "typecheck": "pnpm -r --no-bail --if-present run typecheck",
    "test": "pnpm -r --no-bail --if-present run test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
