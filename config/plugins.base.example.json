{
  "enabled": [
    {
      "name": "@geewiki/db-sqlite"
    },
    {
      "name": "@geewiki/http"
    },
    {
      "name": "@geewiki/auth"
    },
    {
      "name": "@geewiki/org"
    },
    {
      "name": "@geewiki/authz"
    },
    {
      "name": "@geewiki/ops"
    },
    {
      "name": "@geewiki/wiki"
    },
    {
      "name": "@geewiki/builtin-docs",
      "config": {
        "hidden": false
      }
    },
    {
      "name": "@geewiki/search"
    },
    {
      "name": "@geewiki/llm",
      "config": {
        "provider": "openai",
