{
  "name": "@geewiki/ai-summary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GeeWiki AI 摘要：每篇文章自动生成摘要、按摘要检索、以折叠卡显示在文章顶部",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
