  },
  "dependencies": {
    "@geewiki/ai-tools": "workspace:*",
    "@geewiki/core": "workspace:*",
    "@geewiki/llm": "workspace:*",
    "cordis": "^4.0.0-rc.10",
    "schemastery": "3.18.0"
  },
  "devDependencies": {
    "@geewiki/db-sqlite": "workspace:*",
    "@geewiki/wiki": "workspace:*",
    "@types/node": "^26.6.1"
  }
}
