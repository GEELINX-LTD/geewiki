{
  "name": "@geewiki/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GeeWiki 管理界面与 Wiki 前端（React 19 + React Flow）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:fixtures": "rm -rf public/plugins-ui && FIXTURE_OUT_DIR=../../../plugins/ui-demo/dist vite build --config fixtures/vite.config.ts && FIXTURE_OUT=@geewiki-plugin/hello FIXTURE_OUT_DIR=../../../plugins/hello-geewiki/dist vite build --config fixtures/vite.config.ts && FIXTURE_OUT=@geewiki/editor-plain FIXTURE_ENTRY=./editor/index.tsx vite build --config fixtures/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "4.3.3",
    "@xyflow/react": "^12.5.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "lucide-react": "^1.43.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^6.3.5"
  }
}
